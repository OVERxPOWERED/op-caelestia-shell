pragma Singleton

import QtQuick
import Quickshell
import Quickshell.Io
import Quickshell.Hyprland
import Caelestia.Config
import qs.services

Singleton {
    id: root

    // Distribution Strategies:
    // 0: Dedicated blocks per monitor (e.g. 1..10 on Mon 0, 11..20 on Mon 1) [Option A / macOS style]
    // 1: Shared / Dynamic pool (workspaces roam across all monitors)
    // 2: Interleaved (Odd workspaces on Mon 0, Even on Mon 1)
    // 3: Primary display only (Mon 0 has 1..10, secondary displays remain fixed)
    property int strategy: 0

    // Workspaces per display (group size): 10 or 5
    property int workspacesPerDisplay: 10

    // Navigation scope:
    // 0: Stay on current monitor (m±1) [Default]
    // 1: Global sequential (r±1)
    // 2: Skip empty workspaces (e±1)
    property int navigationScope: 0

    // Touchpad Gestures:
    property bool gestureSwipe: true
    property int gestureFingers: 4

    readonly property string rulesPath: `${Paths.home}/.config/hypr/workspaces_rules.lua`
    readonly property string configPath: `${Paths.config}/workspaces.json`

    function setStrategy(val: int): void {
        if (strategy !== val) {
            strategy = val;
            save();
            applyLater.restart();
        }
    }

    function setWorkspacesPerDisplay(val: int): void {
        if (workspacesPerDisplay !== val) {
            workspacesPerDisplay = val;
            GlobalConfig.bar.workspaces.shown = val;
            save();
            applyLater.restart();
        }
    }

    function setNavigationScope(val: int): void {
        if (navigationScope !== val) {
            navigationScope = val;
            save();
            applyLater.restart();
        }
    }

    function setGestureSwipe(val: bool): void {
        if (gestureSwipe !== val) {
            gestureSwipe = val;
            save();
            applyLater.restart();
        }
    }

    function setGestureFingers(val: int): void {
        if (gestureFingers !== val) {
            gestureFingers = val;
            save();
            applyLater.restart();
        }
    }

    function getNextNavTarget(): string {
        switch (navigationScope) {
            case 1: return "m+1";
            case 2: return "e+1";
            default: return "r+1";
        }
    }

    function getPrevNavTarget(): string {
        switch (navigationScope) {
            case 1: return "m-1";
            case 2: return "e-1";
            default: return "r-1";
        }
    }

    function apply(): void {
        if (!Hypr.usingLua) return;

        const mons = Hypr.monitors.values;
        if (!mons || mons.length === 0) return;

        const sortedMons = [...mons].sort((a, b) => a.id - b.id);
        const batch = [];
        const luaLines = [
            "-- Generated by Caelestia WorkspaceManager",
            `-- Strategy: ${strategy} | WorkspacesPerDisplay: ${workspacesPerDisplay} | Scope: ${navigationScope}`,
            ""
        ];

        const monTarget = m => m.description ? `desc:${m.description}` : m.name;

        if (strategy === 0) {
            // Dedicated blocks per monitor (Option A)
            for (let mIdx = 0; mIdx < sortedMons.length; mIdx++) {
                const m = sortedMons[mIdx];
                const base = mIdx * workspacesPerDisplay + 1;
                const target = monTarget(m);

                for (let ws = base; ws < base + workspacesPerDisplay; ws++) {
                    const isDef = (ws === base);
                    const rule = `hl.workspace_rule({ workspace = "${ws}", monitor = "${target}", default = ${isDef}, persistent = ${isDef} })`;
                    batch.push(`eval ${rule}`);
                    luaLines.push(rule);
                }
            }
        } else if (strategy === 1) {
            // Shared / Dynamic pool (no monitor lock)
            const total = workspacesPerDisplay * Math.max(1, sortedMons.length);
            for (let ws = 1; ws <= total; ws++) {
                const rule = `hl.workspace_rule({ workspace = "${ws}", monitor = "" })`;
                batch.push(`eval ${rule}`);
                luaLines.push(rule);
            }
        } else if (strategy === 2) {
            // Interleaved (Odd/Even across monitors)
            const total = workspacesPerDisplay * Math.max(1, sortedMons.length);
            for (let ws = 1; ws <= total; ws++) {
                const m = sortedMons[(ws - 1) % sortedMons.length];
                const target = monTarget(m);
                const isDef = (ws <= sortedMons.length);
                const rule = `hl.workspace_rule({ workspace = "${ws}", monitor = "${target}", default = ${isDef}, persistent = ${isDef} })`;
                batch.push(`eval ${rule}`);
                luaLines.push(rule);
            }
        } else if (strategy === 3) {
            // Primary display only
            const primary = sortedMons[0];
            const pTarget = monTarget(primary);
            for (let ws = 1; ws <= workspacesPerDisplay; ws++) {
                const isDef = (ws === 1);
                const rule = `hl.workspace_rule({ workspace = "${ws}", monitor = "${pTarget}", default = ${isDef}, persistent = ${isDef} })`;
                batch.push(`eval ${rule}`);
                luaLines.push(rule);
            }
            for (let mIdx = 1; mIdx < sortedMons.length; mIdx++) {
                const m = sortedMons[mIdx];
                const sWs = workspacesPerDisplay + mIdx;
                const rule = `hl.workspace_rule({ workspace = "${sWs}", monitor = "${monTarget(m)}", default = true, persistent = true })`;
                batch.push(`eval ${rule}`);
                luaLines.push(rule);
            }
        }

        if (batch.length > 0 && Hypr.extras) {
            Hypr.extras.batchMessage(batch);
        }

        // Persist to lua file
        rulesFile.setText(luaLines.join("\n") + "\n");
    }

    function save(): void {
        configFile.setText(JSON.stringify({
            strategy: strategy,
            workspacesPerDisplay: workspacesPerDisplay,
            navigationScope: navigationScope,
            gestureSwipe: gestureSwipe,
            gestureFingers: gestureFingers
        }, null, 2) + "\n");
    }

    Timer {
        id: applyLater

        interval: 350
        onTriggered: root.apply()
    }

    FileView {
        id: configFile

        path: root.configPath
        printErrors: false
        onLoaded: {
            try {
                const data = JSON.parse(text());
                if (data.strategy !== undefined) root.strategy = data.strategy;
                if (data.workspacesPerDisplay !== undefined) root.workspacesPerDisplay = data.workspacesPerDisplay;
                if (data.navigationScope !== undefined) root.navigationScope = data.navigationScope;
                if (data.gestureSwipe !== undefined) root.gestureSwipe = data.gestureSwipe;
                if (data.gestureFingers !== undefined) root.gestureFingers = data.gestureFingers;
            } catch (e) {
                console.warn("[WorkspaceManager] Error parsing workspaces.json:", e);
            }
            applyLater.restart();
        }
        onLoadFailed: applyLater.restart()
    }

    FileView {
        id: rulesFile

        path: root.rulesPath
        printErrors: false
    }

    Connections {
        function onConfigReloaded(): void {
            applyLater.restart();
        }

        target: Hypr
    }
}
